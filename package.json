{
    "name": "svelte-template",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "generate-types": "openapi-typescript http://localhost:8000/schema/openapi.json --output src/lib/types/api.ts",
        "dev": "vite dev --host 0.0.0.0 --port 8000",
        "build": "svelte-kit sync && vite build",
        "lint": "biome check . --error-on-warnings",
        "lint:fix": "biome check . --write --error-on-warnings",
        "lint-format": "biome check --write",
        "format": "biome format .",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "preview": "vite preview",
        "precommit": "npm run build && npm run lint && npm run check",
        "prepush": "npm run precommit && npm run test:unit && npm run test:e2e",
        "test:unit": "vitest run",
        "pretest": "mkdir -p static/_tests && cp test_vid.mp4 static/_tests/test_vid.mp4",
        "test": "npm run test:unit -- --run && npm run test:e2e",
        "posttest": "node -e \"if(process.env.GITHUB_ACTIONS==='true'){require('fs').unlinkSync('static/_tests/test_vid.mp4');console.log('Deleted test video');}\"",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.4",
        "@playwright/test": "^1.61.0",
        "@sveltejs/adapter-static": "^3.0.8",
        "@sveltejs/kit": "^2.22.0",
        "@sveltejs/vite-plugin-svelte": "^6.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitest/browser": "^3.2.3",
        "chart.js": "^4.5.0",
        "globals": "^16.0.0",
        "openapi-typescript": "^7.9.1",
        "peerjs": "^1.5.5",
        "playwright": "^1.61.0",
        "svelte": "^5.0.0",
        "svelte-5-french-toast": "^2.0.6",
        "svelte-check": "^4.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.0.0",
        "vite": "^7.0.4",
        "vitest": "^3.2.3",
        "vitest-browser-svelte": "^0.1.0",
        "zod": "^4.3.6"
    }
}
